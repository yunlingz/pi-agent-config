{
  "bash": {
    "path": "example.sh",
    "source": "# keep\necho before\n",
    "pattern": "echo $VALUE",
    "replacement": "printf $VALUE",
    "expected": "# keep\nprintf before\n"
  },
  "c": {
    "path": "example.c",
    "source": "// keep\nvoid example(void) { before(value); }\n",
    "pattern": "before($VALUE);",
    "replacement": "after($VALUE);",
    "expected": "// keep\nvoid example(void) { after(value); }\n"
  },
  "cmake": {
    "path": "CMakeLists.txt",
