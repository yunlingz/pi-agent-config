{
  "project": "https://github.com/can1357/oh-my-pi",
  "revision": "1bdbf6d242d99ca62bdf2feeff4519ff992f647d",
  "runtimeDependencies": {
    "tree-sitter": "0.25.10",
    "tree-sitter-language": "0.1.7",
    "ast-grep-core": "0.39.9"
  },
  "sourceAreas": [
    "crates/pi-edit/src/modes/hashline",
    "crates/pi-edit/src/store.rs",
    "crates/pi-ast/src/language",
    "crates/pi-ast/src/ops.rs",
    "crates/pi-ast/src/search",
    "packages/coding-agent/src/edit",
    "packages/coding-agent/src/tools/read.ts",
    "packages/coding-agent/src/tools/ast-grep.ts",
    "packages/coding-agent/src/tools/ast-edit.ts"
  ],
  "astScope": {
    "grammars": "grammars.json",
    "grammarCount": 22,
    "ompLanguageParityRequired": false,
    "strictOmpParityRequired": false,
    "preferTestedImprovements": true,
    "localFilesOnly": true,
    "fallback": "Ordinary reads, hashline text edits, and grep",
    "ompApplicationStoresRequired": false
  },
  "runtime": {
    "interface": "WebAssembly JavaScript API",
    "host": "Node.js",
    "ompPackagesRequired": false,
    "runtimeDownloads": false,
    "runtimeCompilationRequired": false,
    "distribution": "One identical package for every supported platform",
    "platforms": ["linux", "windows", "macos", "wsl"],
    "developmentVerificationEnvironments": ["windows", "linux-under-wsl"],
    "platformSpecificBinaries": false,
    "target": "wasm32-unknown-unknown",
    "wasiRequired": false,
    "wasmtimeRequired": false,
    "filesystem": "Explicit Node host adapter; no guest OS filesystem"
  }
}
