    "read",
    "bash",
    "edit",
    "write",
    "grep",
    "find",
    "ls"
  ],
  "enabledModels": [
    "existing_gateway/gpt-6-astra",
    "existing_gateway/gpt-6.1-sol",
    "existing_gateway/gpt-6.1-terra"
  ],
  "defaultThinkingLevel": "xhigh",
  "modelThinkingLevels": {
    "existing_gateway/gpt-6-astra": "high",
    "existing_gateway/gpt-6.1-sol": "xhigh",
    "existing_gateway/gpt-6.1-terra": "max"
  },
  "compaction": {
    "modelOverrides": {
      "existing_gateway/gpt-6-astra": {
        "reserveTokens": 192000
      },
      "existing_gateway/gpt-6.1-sol": {
        "reserveTokens": 192000
      },
      "existing_gateway/gpt-6.1-terra": {
        "reserveTokens": 192000
      }
    }
  },
  "lastChangelogVersion": "1.5.1",
  "packages": [
    "npm:@juicesharp/rpiv-todo@2.15.0",
    "npm:@juicesharp/rpiv-ask-user-question@2.15.0",
    "npm:pi-powerline-footer@0.22.0",
    "npm:@plannotator/pi-extension@0.28.59"
  ],
  "workingVibe": "off",
  "powerline": {
    "preset": "default",
    "welcome": false,
