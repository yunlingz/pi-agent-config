{
  "theme": "ci_dark",
  "defaultProvider": "existing_gateway",
  "defaultModel": "gpt-latest",
  "defaultThinkingLevel": "max",
  "lastChangelogVersion": "1.3.0",
  "extensions": ["-builtin:mcp"],
  "packages": [
    "npm:@juicesharp/rpiv-todo@2.13.9",
    "npm:@juicesharp/rpiv-ask-user-question@2.13.9",
    "npm:pi-powerline-footer@0.20.2"
  ],
  "workingVibe": "off",
  "powerline": {
    "preset": "default",
    "welcome": false,
    "git": { "polling": "branch" },
    "disabledSegments": ["cache_read"],
    "customItems": [
      {
        "id": "cache_rate",
        "statusKey": "cache-rate",
        "position": "left",
        "color": "muted"
      }
    ],
    "layout": {
      "left": [
        "model",
        "thinking",
        "shell_mode",
        "path",
        "git",
        "queue",
        "context_pct",
        "custom:cache_rate",
        "cost"
      ]
    },
    "queue": { "compactPromptMode": "native" },
    "autoFollowUp": false
  }
}