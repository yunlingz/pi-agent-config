{
  "theme": "ci_dark",
  "defaultProvider": "existing_gateway",
  "defaultModel": "gpt-6.1-sol",
  "transport": "sse",
  "enabledModels": [
    "existing_gateway/gpt-6.1-sol",
    "existing_gateway/gpt-6-astra"
  ],
  "defaultThinkingLevel": "max",
  "compaction": {
    "modelOverrides": {
      "existing_gateway/gpt-6-astra": {
        "reserveTokens": 192000
      },
      "existing_gateway/gpt-6.1-sol": {
        "reserveTokens": 192000
      }
    }
  },
  "lastChangelogVersion": "1.4.0",
  "extensions": [
    "-builtin:mcp"
  ],
  "packages": [
    "npm:@juicesharp/rpiv-todo@2.15.0",
    "npm:@juicesharp/rpiv-ask-user-question@2.15.0",
    "npm:pi-powerline-footer@0.21.0",
    "npm:@plannotator/pi-extension@0.28.33",
    "npm:@sting8k/pi-vcc@0.11.1"
  ],
  "workingVibe": "off",
  "powerline": {
    "preset": "default",
    "welcome": false,
    "git": {
      "polling": "branch"
    },
    "disabledSegments": [
      "cache_read"
    ],
    "customItems": [
      {
        "id": "cache_rate",
        "statusKey": "cache-rate",
        "position": "left",
        "color": "muted"
      }
    ],
    "layout": {
      "left": [
        "model",
        "thinking",
        "shell_mode",
        "path",
        "git",
        "queue",
        "context_pct",
        "custom:cache_rate",
        "cost"
      ]
    },
    "queue": {
      "compactPromptMode": "native"
    },
    "autoFollowUp": false
  }
}
